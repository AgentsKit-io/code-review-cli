{
  "name": "@agentskit/code-review",
  "version": "0.1.0",
  "type": "module",
  "description": "Provider-agnostic, low-noise AI code review for local development and GitHub Actions.",
  "license": "MIT",
  "bin": {
    "agentskit-review": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsKit-io/code-review-cli.git"
  },
  "homepage": "https://github.com/AgentsKit-io/code-review-cli#readme",
  "bugs": "https://github.com/AgentsKit-io/code-review-cli/issues",
  "keywords": [
    "ai-code-review",
    "code-review",
    "github-action",
    "llm",
    "ollama"
  ],
  "scripts": {
    "review": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node dist/src/cli.js --help",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentskit/adapters": "^0.12.2",
    "@agentskit/core": "^1.9.0",
    "@agentskit/ink": "^0.9.0",
    "@agentskit/runtime": "^0.7.3",
    "@agentskit/tools": "^0.9.4",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
